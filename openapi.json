{
  "openapi": "3.1.0",
  "info": {
    "title": "Gipfel Lodge Public Information API",
    "version": "1.0.0",
    "description": "Public status endpoint only. This API does not expose booking availability, prices, guest data, or administrative operations."
  },
  "servers": [
    {
      "url": "https://gipfellodge.at"
    }
  ],
  "paths": {
    "/api/status.php": {
      "get": {
        "summary": "Public website status",
        "operationId": "getWebsiteStatus",
        "responses": {
          "200": {
            "description": "Public website information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "service",
          "status",
          "website"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "resolution"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
